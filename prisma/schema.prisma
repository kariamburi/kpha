// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum EventCategory {
  GENERAL
  AGM
  CONFERENCE
  TRAINING
  WORKSHOP
  WEBINAR
}

enum NewsCategory {
  LATEST
  NOTICES
  CHAIRMAN_MESSAGES
  INDUSTRY_UPDATES
  PRESS_RELEASES
}

enum EventBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum EventPaymentMethod {
  PAYSTACK
  FREE
  MANUAL
}

model User {
  id       String     @id @default(cuid())
  name     String
  email    String     @unique
  phone    String?
  password String
  role     Role       @default(MEMBER)
  status   UserStatus @default(ACTIVE)

  member         Member?
  applications   MembershipApplication[]
  adminLoginOtps AdminLoginOtp[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
}

model MembershipCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  annualFee   Float
  active      Boolean @default(true)

  members      Member[]
  applications MembershipApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MembershipApplication {
  id String @id @default(cuid())

  userId     String?
  categoryId String?

  fullName String?
  email    String?
  phone    String?
  idNumber String?

  // Educational details
  qualification String?
  institution   String?

  // Current employment
  position String?
  employer String?

  // Professional experience
  experience String? @db.Text

  // Data protection consent
  dataProtectionConsent Boolean   @default(false)
  consentedAt           DateTime?

  idDocumentUrl       String?
  qualificationDocUrl String?
  cvDocumentUrl       String?

  paymentReference String?
  paymentStatus    PaymentStatus @default(PENDING)

  status  ApplicationStatus @default(PENDING)
  remarks String?

  user     User?               @relation(fields: [userId], references: [id])
  category MembershipCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id     String  @id @default(cuid())
  userId String? @unique

  adminRole   Role?
  adminStatus UserStatus @default(INACTIVE)

  fullName String?
  email    String?
  phone    String?

  profileImageUrl String?

  county             String?
  position           String?
  employer           String?
  isDirectoryVisible Boolean @default(true)

  categoryId   String
  memberNumber String           @unique
  joinDate     DateTime         @default(now())
  expiryDate   DateTime
  status       MembershipStatus @default(ACTIVE)

  user     User?              @relation(fields: [userId], references: [id])
  category MembershipCategory @relation(fields: [categoryId], references: [id])

  payments           Payment[]
  certificates       Certificate[]
  loginOtps          MemberLoginOtp[]
  eventRegistrations EventRegistration[]
  notifications      Notification[]

  educations      MemberEducation[]
  workExperiences MemberWorkExperience[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberEducation {
  id       String @id @default(cuid())
  memberId String

  level       String?
  institution String?
  year        String?
  achievement String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberWorkExperience {
  id       String @id @default(cuid())
  memberId String

  company     String?
  position    String?
  description String? @db.Text

  startDate DateTime?
  endDate   DateTime?

  // Keep temporarily for old records.
  year String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        String        @id @default(cuid())
  memberId  String
  amount    Float
  method    String
  reference String?
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?

  member Member @relation(fields: [memberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certificate {
  id                String   @id @default(cuid())
  memberId          String
  certificateNumber String   @unique
  issueDate         DateTime @default(now())
  expiryDate        DateTime
  verificationCode  String   @unique
  pdfUrl            String?

  member Member @relation(fields: [memberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberLoginOtp {
  id        String   @id @default(cuid())
  memberId  String
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id])
}

model WebsitePage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  subtitle  String?
  content   String?  @db.Text
  imageUrl  String?
  seoTitle  String?
  seoDesc   String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leader {
  id        String   @id @default(cuid())
  name      String
  title     String
  bio       String?  @db.Text
  imageUrl  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category NewsCategory @default(LATEST)

  @@index([published, publishedAt])
  @@index([category, published, publishedAt])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  category    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  description String @db.Text

  venue     String?
  eventDate DateTime
  endDate   DateTime?

  imageUrl String?

  cpdPoints Int?

  capacity Int?
  fee      Float? @default(0)

  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations EventRegistration[]

  category EventCategory @default(GENERAL)

  @@index([published, eventDate])
  @@index([category, published, eventDate])
}

model EventRegistration {
  id      String @id @default(cuid())
  eventId String

  // Optional because non-members can book.
  memberId String?

  bookingNumber String @unique

  fullName     String
  phone        String
  email        String
  organisation String?

  membershipNumber String?
  paymentDetails   String? @db.Text

  amount Float @default(0)

  status        EventBookingStatus  @default(PENDING)
  paymentStatus PaymentStatus       @default(PENDING)
  paymentMethod EventPaymentMethod?

  paymentReference String?
  paidAt           DateTime?

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([email])
  @@index([phone])
  @@index([paymentStatus])
}

enum AnnouncementType {
  GENERAL
  RENEWAL
  EVENT
  POLICY
  NEWSLETTER
}

model Announcement {
  id        String           @id @default(cuid())
  title     String
  message   String           @db.Text
  type      AnnouncementType @default(GENERAL)
  published Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id       String  @id @default(cuid())
  memberId String?
  title    String
  message  String  @db.Text
  read     Boolean @default(false)

  reminderKey String?

  member Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, reminderKey])
}

model EmailCampaign {
  id       String    @id @default(cuid())
  subject  String
  body     String    @db.Text
  audience String    @default("ALL_MEMBERS")
  sent     Boolean   @default(false)
  sentAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String  @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   String? @db.Text

  createdAt DateTime @default(now())
}

model ContactSetting {
  id           String  @id @default("main")
  address      String? @db.Text
  email        String?
  phone1       String?
  phone2       String?
  facebookUrl  String?
  twitterUrl   String?
  linkedinUrl  String?
  instagramUrl String?
  mapUrl       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CertificateSetting {
  id                   String   @id @default("main")
  chairpersonName      String?
  chairpersonSignature String?
  secretaryName        String?
  secretarySignature   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SystemSetting {
  id              String  @id @default("main")
  adminOtpEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminLoginOtp {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GalleryCategory {
  EVENTS
  AGM
  CONFERENCE
  TRAINING
  AWARDS
  COMMUNITY
  OTHER
}

enum GalleryMediaType {
  IMAGE
  YOUTUBE
}

model GalleryAlbum {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String?         @db.Text
  coverImageUrl String?
  category      GalleryCategory @default(EVENTS)
  eventDate     DateTime?
  featured      Boolean         @default(false)
  published     Boolean         @default(false)
  order         Int             @default(0)

  items GalleryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@index([category])
  @@index([eventDate])
}

model GalleryItem {
  id           String           @id @default(cuid())
  albumId      String
  type         GalleryMediaType
  imageUrl     String?
  youtubeUrl   String?
  youtubeId    String?
  thumbnailUrl String?
  title        String?
  caption      String?          @db.Text
  order        Int              @default(0)

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId])
  @@index([albumId, order])
  @@index([type])
}
